# ==============================================================================
# WAAA Production & Cloud Environment Configuration Template
# Copy to .env or configure in your Render Dashboard Environment Variables
# ==============================================================================

# Node Environment
NODE_ENV=production

# Server Port (Render sets PORT automatically, defaults to 10000)
PORT=10000

# Persistent Disk Mount Path (Render Persistent Disk mount path, e.g., /var/data/waaa)
# If left unset or empty, WAAA will default to local project directories: ./data, ./auth_info
WAAA_STORAGE_DIR=

# Google Gemini API Keys (at least 1 key for AI features; multiple keys enable automatic rotation)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Blockchain Trust & Proof Layer (Phase 15)
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_NETWORK=local_proof_registry
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=

# Media Processing Limits (Optional)
WAAA_MAX_IMAGE_SIZE_MB=5
WAAA_MAX_PDF_SIZE_MB=15
