{
  "name": "waaa-backend-minimal",
  "version": "0.1.0",
  "description": "WAAA Phase 1 only: WhatsApp connection via Baileys, logging messages to console + a local file. No Firebase, no dashboard yet.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/runtimeServer.js",
    "bot": "node src/index.js",
    "api": "node src/api/server.js",
    "db:test": "node database/scripts/verify_mysql_connection.js",
    "db:migrate": "node database/migrations/migrate_json_to_mysql.js",
    "db:export": "node database/migrations/export_mysql_to_json.js",
    "demo": "node run_assignment.js",
    "demo:all": "node run_assignment.js all",
    "demo:stats": "node run_assignment.js stats"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "git": "^0.1.5",
    "mysql2": "^3.24.6",
    "pino": "^9.4.0",
    "qrcode-terminal": "^0.12.0",
    "sql.js": "^1.15.0"
  }
}
